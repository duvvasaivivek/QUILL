# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=quill
POSTGRES_USER=quill
POSTGRES_PASSWORD=quill_local_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

